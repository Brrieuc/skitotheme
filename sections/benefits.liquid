<section class="section" id="benefits" aria-labelledby="benefits-heading">
  <div class="container">

    <div class="text-center fade-in">
      {%- if section.settings.label != blank -%}
        <p class="section-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2 class="section-title" id="benefits-heading">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="benefits-grid">
      {%- for block in section.blocks -%}
        <div class="benefit-card glass-card fade-in fade-in-delay-{{ forloop.index }}"
             {{ block.shopify_attributes }}>
          <div class="benefit-icon" aria-hidden="true">{{ block.settings.icon }}</div>
          <h3 class="benefit-title">{{ block.settings.title }}</h3>
          <p class="benefit-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Avantages",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label de section",
      "default": "Pourquoi choisir Skito"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Conçu pour votre vie en extérieur"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Des produits simples, pratiques et efficaces pour profiter dehors sans contrainte."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Avantage",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icône",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Idéal en extérieur"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Terrasse, jardin, camping ou voyage — nos produits s'adaptent à toutes vos sorties."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avantages",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "🛡️",
            "title": "Protection en extérieur",
            "description": "Terrasse, jardin, camping ou voyage — profitez de l'air frais sans les désagréments des moustiques."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🎒",
            "title": "Compact et pratique",
            "description": "Format léger, facile à transporter. Glissez-le dans votre sac pour l'emmener partout."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "✨",
            "title": "Simple à utiliser",
            "description": "Pas de mode d'emploi compliqué. Déballez, installez, profitez."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "📦",
            "title": "Livraison rapide",
            "description": "Commandez aujourd'hui, recevez rapidement. Suivi de colis inclus."
          }
        }
      ]
    }
  ]
}
{% endschema %}
