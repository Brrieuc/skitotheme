<section class="section bundles" id="bundles" aria-labelledby="bundles-heading">
  <div class="container">

    <div class="text-center fade-in">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title" id="bundles-heading">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="bundles-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'bundle' -%}
          <div class="bundle-card glass-card fade-in fade-in-delay-{{ forloop.index }} {% if block.settings.featured %}featured{% endif %}"
               data-bundle="{{ block.id }}"
               data-variant="{{ block.settings.variant_id }}"
               data-qty="{{ block.settings.quantity }}"
               {{ block.shopify_attributes }}>

            {%- if block.settings.featured -%}
              <span class="bundle-badge">⭐ {{ block.settings.featured_label }}</span>
            {%- endif -%}

            <div class="bundle-name">{{ block.settings.name }}</div>
            <div class="bundle-description">{{ block.settings.description }}</div>

            <div class="bundle-price-area">
              <span class="bundle-price">{{ block.settings.price }}</span>
              {%- if block.settings.compare_price != blank -%}
                <span class="bundle-price-compare">{{ block.settings.compare_price }}</span>
              {%- endif -%}
              <div style="margin-top:0.25rem;">
                <span class="badge badge-green">{{ block.settings.save_text }}</span>
              </div>
            </div>

            <ul class="bundle-features" role="list">
              {%- for i in (1..5) -%}
                {%- assign feature_key = 'feature_' | append: i -%}
                {%- assign feature_val = block.settings[feature_key] -%}
                {%- if feature_val != blank -%}
                  <li class="bundle-feature">
                    <span class="bundle-feature-icon" aria-hidden="true">✓</span>
                    {{ feature_val }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if block.settings.variant_id != blank -%}
              <button class="btn bundle-atc-btn btn-full {% if block.settings.featured %}btn-primary{% else %}btn-secondary{% endif %}"
                      onclick="window.SkitoCart && window.SkitoCart.addToCart('{{ block.settings.variant_id }}', {{ block.settings.quantity | default: 1 }})">
                {{ block.settings.cta_text | default: 'Ajouter au panier' }}
              </button>
            {%- else -%}
              <a href="{{ block.settings.cta_url | default: routes.all_products_collection_url }}"
                 class="btn btn-full {% if block.settings.featured %}btn-primary{% else %}btn-secondary{% endif %}">
                {{ block.settings.cta_text | default: 'Voir le pack' }}
              </a>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Packs / Bundles",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
