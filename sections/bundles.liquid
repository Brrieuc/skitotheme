{%- comment -%}
  Section : Produits mis en avant
  Remplace l'ancienne section "Packs/Bundles" qui contenait des offres fictives.
  Utilise des product pickers Shopify réels ou un lien vers une collection.
{%- endcomment -%}

<section class="section bundles" id="featured-products" aria-labelledby="featured-products-heading">
  <div class="container">

    <div class="text-center fade-in">
      {%- if section.settings.label != blank -%}
        <p class="section-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2 class="section-title" id="featured-products-heading">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Mode collection — affiche les produits d'une collection Shopify {%- endcomment -%}
    {%- if section.settings.collection != blank -%}
      {%- assign fp_collection = section.settings.collection -%}
      <div class="product-cards-grid" style="margin-top:3rem;">
        {%- for product in fp_collection.products limit: section.settings.products_limit -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <p class="text-muted text-center" style="grid-column:1/-1;">
            Aucun produit dans cette collection pour l'instant.
          </p>
        {%- endfor -%}
      </div>

    {%- comment -%} Mode sélection manuelle — product pickers individuels {%- endcomment -%}
    {%- elsif section.blocks.size > 0 -%}
      <div class="bundles-grid" style="margin-top:3rem;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' -%}
            {%- assign fp = block.settings.product -%}
            {%- if fp != blank -%}
              <div class="bundle-card glass-card fade-in fade-in-delay-{{ forloop.index }} {% if block.settings.highlight %}featured{% endif %}"
                   {{ block.shopify_attributes }}>

                {%- if block.settings.highlight and block.settings.highlight_label != blank -%}
                  <span class="bundle-badge">{{ block.settings.highlight_label }}</span>
                {%- endif -%}

                {%- if fp.featured_image != blank -%}
                  <a href="{{ fp.url }}" style="display:block;border-radius:var(--radius-md);overflow:hidden;margin-bottom:1.25rem;aspect-ratio:4/3;background:rgba(140,255,102,0.04);">
                    <img src="{{ fp.featured_image | image_url: width: 600 }}"
                         alt="{{ fp.featured_image.alt | escape | default: fp.title }}"
                         width="600"
                         style="width:100%;height:100%;object-fit:cover;"
                         loading="lazy">
                  </a>
                {%- endif -%}

                <div class="bundle-name">
                  <a href="{{ fp.url }}" style="color:inherit;text-decoration:none;">{{ fp.title }}</a>
                </div>

                {%- if fp.description != blank -%}
                  <div class="bundle-description">
                    {{ fp.description | strip_html | truncate: 100 }}
                  </div>
                {%- endif -%}

                <div class="bundle-price-area">
                  <span class="bundle-price">{{ fp.price | money }}</span>
                  {%- if fp.compare_at_price > fp.price -%}
                    <span class="bundle-price-compare">{{ fp.compare_at_price | money }}</span>
                    <span class="badge badge-green" style="display:inline-flex;margin-top:0.5rem;font-size:0.7rem;">
                      -{{ fp.compare_at_price | minus: fp.price | times: 100.0 | divided_by: fp.compare_at_price | round }}%
                    </span>
                  {%- endif -%}
                </div>

                {%- form 'product', fp, class: 'atc-form' -%}
                  <input type="hidden" name="id" value="{{ fp.selected_or_first_available_variant.id }}">
                  {%- if fp.available -%}
                    <button type="submit"
                            class="btn btn-full {% if block.settings.highlight %}btn-primary{% else %}btn-secondary{% endif %} mt-3"
                            data-original-text="Ajouter au panier">
                      Ajouter au panier
                    </button>
                  {%- else -%}
                    <a href="{{ fp.url }}" class="btn btn-secondary btn-full mt-3">
                      Voir le produit
                    </a>
                  {%- endif -%}
                {%- endform -%}

              </div>
            {%- else -%}
              {%- comment -%} Block vide — affiché uniquement dans le customizer {%- endcomment -%}
              <div class="bundle-card glass-card" {{ block.shopify_attributes }}
                   style="display:flex;align-items:center;justify-content:center;min-height:200px;opacity:0.4;">
                <p class="text-muted" style="font-size:0.875rem;text-align:center;">
                  Sélectionnez un produit<br>dans les paramètres du bloc
                </p>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- else -%}
      <p class="text-muted text-center" style="margin-top:2rem;">
        Configurez cette section en sélectionnant une collection ou en ajoutant des blocs produits.
      </p>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:3rem;">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
           class="btn btn-secondary btn-lg fade-in">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Produits mis en avant",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Nos produits"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos best-sellers"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Sélectionnés pour leur efficacité et leur praticité en extérieur."
    },
    {
      "type": "header",
      "content": "Mode collection (option 1)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Afficher les produits d'une collection",
      "info": "Si une collection est sélectionnée, elle prend la priorité sur les blocs produits ci-dessous."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Nombre de produits à afficher",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Bouton bas de section"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texte du bouton (optionnel)",
      "default": "Voir tous les produits"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du bouton"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produit",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit Shopify"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Mettre ce produit en avant",
          "default": false
        },
        {
          "type": "text",
          "id": "highlight_label",
          "label": "Label si mis en avant",
          "default": "⭐ Best-seller"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produits mis en avant",
      "blocks": [
        { "type": "product" },
        { "type": "product", "settings": { "highlight": true, "highlight_label": "⭐ Best-seller" } },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
