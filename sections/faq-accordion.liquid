<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="container">

    <div class="text-center fade-in">
      {%- if section.settings.label != blank -%}
        <p class="section-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2 class="section-title" id="faq-heading">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="faq-list fade-in" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="faq-item" role="listitem" {{ block.shopify_attributes }}>
            <button class="faq-question"
                    aria-expanded="false"
                    aria-controls="faq-answer-{{ block.id }}">
              {{ block.settings.question }}
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer"
                 id="faq-answer-{{ block.id }}"
                 role="region">
              <div class="faq-answer-inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank -%}
      <div class="text-center" style="margin-top:2.5rem;">
        <p class="text-muted" style="margin-bottom:1rem;">{{ section.settings.contact_text }}</p>
        {%- if section.settings.contact_cta_text != blank -%}
          <a href="{{ section.settings.contact_cta_url }}" class="btn btn-secondary">
            {{ section.settings.contact_cta_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Vous avez des questions ?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Retrouvez les réponses aux questions les plus courantes."
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texte contact (optionnel)",
      "default": "Vous n'avez pas trouvé votre réponse ?"
    },
    {
      "type": "text",
      "id": "contact_cta_text",
      "label": "Bouton contact",
      "default": "Contactez-nous"
    },
    {
      "type": "url",
      "id": "contact_cta_url",
      "label": "Lien bouton contact"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Quels sont les délais de livraison ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Les commandes sont généralement expédiées sous 1 à 3 jours ouvrés. Un email de confirmation avec numéro de suivi vous est envoyé dès l'expédition.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Quels sont les délais de livraison ?",
            "answer": "<p>Les commandes sont généralement traitées sous 1 à 3 jours ouvrés. Un email de confirmation avec numéro de suivi vous est envoyé dès l'expédition.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Comment suivre ma commande ?",
            "answer": "<p>Dès l'expédition de votre colis, vous recevez un email avec un numéro de suivi. Vous pouvez tracker votre commande en temps réel via le lien fourni.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Puis-je retourner un produit ?",
            "answer": "<p>Oui. Vous disposez de 30 jours à compter de la réception pour retourner un produit. Contactez notre service client pour initier la procédure de retour.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Quels moyens de paiement acceptez-vous ?",
            "answer": "<p>Nous acceptons les cartes bancaires (Visa, Mastercard, American Express) ainsi que PayPal. Tous les paiements sont sécurisés par chiffrement SSL.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Livrez-vous à l'international ?",
            "answer": "<p>Nous livrons en France métropolitaine et dans plusieurs pays européens. Les options et délais disponibles selon votre pays sont affichés lors du passage en caisse.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
