<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="container">

    <div class="text-center fade-in">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title" id="faq-heading">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="faq-list fade-in" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="faq-item" role="listitem" {{ block.shopify_attributes }}>
            <button class="faq-question"
                    aria-expanded="false"
                    aria-controls="faq-answer-{{ block.id }}">
              {{ block.settings.question }}
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" id="faq-answer-{{ block.id }}" role="region">
              <div class="faq-answer-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank -%}
      <div class="text-center" style="margin-top:2.5rem;">
        <p class="text-muted" style="margin-bottom:1rem;">{{ section.settings.contact_text }}</p>
        {%- if section.settings.contact_cta_text != blank -%}
          <a href="{{ section.settings.contact_cta_url }}" class="btn btn-secondary">
            {{ section.settings.contact_cta_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Vous avez des questions ?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Trouvez les réponses aux questions les plus courantes sur Skito."
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texte contact",
      "default": "Vous n'avez pas trouvé votre réponse ?"
    },
    {
      "type": "text",
      "id": "contact_cta_text",
      "label": "Bouton contact",
      "default": "Contactez notre équipe"
    },
    {
      "type": "url",
      "id": "contact_cta_url",
      "label": "Lien bouton contact"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Comment fonctionne Skito ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Skito utilise une technologie d'émission ultrasonique et thermique pour repousser les moustiques dans un rayon de plusieurs mètres. Il se recharge via USB et fonctionne jusqu'à 12h d'affilée.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "Comment fonctionne Skito exactement ?",
            "answer": "<p>Skito combine plusieurs technologies pour repousser les moustiques : émission d'ultrasons, diffusion légère de vapeur répulsive et chaleur ciblée. L'ensemble crée une zone de protection dans un rayon de 3 à 5 mètres autour de l'appareil.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Quelle est l'autonomie de la batterie ?",
            "answer": "<p>La batterie intégrée offre jusqu'à 12 heures d'utilisation continue sur une seule charge. La recharge complète prend environ 2 heures via le câble USB-C inclus.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Est-ce que Skito est sûr pour les enfants et les animaux ?",
            "answer": "<p>Oui, Skito est conçu pour être sûr pour toute la famille. Il n'émet aucun produit chimique nocif et n'est pas toxique pour les animaux domestiques. Les ultrasons sont à une fréquence inaudible pour les humains et la majorité des animaux de compagnie.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Skito fonctionne-t-il en extérieur ?",
            "answer": "<p>Absolument. Skito est conçu spécifiquement pour l'utilisation en extérieur : terrasse, jardin, camping, festivals, voyages. Il est résistant aux éclaboussures et efficace même par vent léger.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Quelle est votre politique de retour ?",
            "answer": "<p>Nous offrons une garantie satisfait ou remboursé de 30 jours. Si Skito ne vous convient pas, contactez notre service client et nous vous remboursons intégralement, sans questions posées.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Combien de temps pour recevoir ma commande ?",
            "answer": "<p>Toutes les commandes sont expédiées sous 24h ouvrées. La livraison standard prend 3 à 5 jours ouvrés en France métropolitaine. La livraison express (24-48h) est disponible en option.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
