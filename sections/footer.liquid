<footer class="site-footer" role="contentinfo">
  <div class="container">

    {%- comment -%} ── Top row ── {%- endcomment -%}
    <div class="footer-inner">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="footer-brand">
        <a href="{{ routes.root_url }}"
           class="footer-logo"
           aria-label="{{ shop.name }} — Accueil">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 240 }}"
                 alt="{{ section.settings.logo.alt | escape | default: shop.name }}"
                 width="{{ section.settings.logo_width | default: 100 }}"
                 height="auto"
                 style="width:{{ section.settings.logo_width | default: 100 }}px;height:auto;"
                 loading="lazy">
          {%- else -%}
            <div class="logo-icon" aria-hidden="true">⚡</div>
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.brand_description != blank -%}
          <p class="footer-tagline">{{ section.settings.brand_description }}</p>
        {%- endif -%}

        {%- comment -%} Social links {%- endcomment -%}
        <div class="footer-socials">
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}"
               class="footer-social"
               aria-label="Instagram"
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}"
               class="footer-social"
               aria-label="TikTok"
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.88a8.17 8.17 0 004.84 1.57V7.03a4.85 4.85 0 01-1.07-.34z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}"
               class="footer-social"
               aria-label="Facebook"
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}"
               class="footer-social"
               aria-label="YouTube"
               target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Dynamic link columns from blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer-col-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer-links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if block.type == 'newsletter' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="footer-col-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <p style="font-size:0.8rem;color:var(--color-text-muted);margin-bottom:1rem;line-height:1.5;">
                {{ block.settings.subtext }}
              </p>
            {%- endif -%}
            {%- form 'customer', id: 'footer-newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                <input type="email"
                       name="contact[email]"
                       placeholder="{{ block.settings.placeholder | default: 'Votre email' }}"
                       required
                       autocomplete="email"
                       style="flex:1;min-width:0;padding:0.625rem 1rem;background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:var(--radius-full);color:var(--color-text);font-size:0.875rem;outline:none;font-family:inherit;"
                       aria-label="Adresse email">
                <button type="submit"
                        class="btn btn-primary btn-sm"
                        style="flex-shrink:0;">
                  {{ block.settings.button_text | default: 'OK' }}
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p style="color:var(--color-green);font-size:0.8rem;margin-top:0.5rem;">
                  ✓ Merci pour votre inscription !
                </p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="neon-divider" style="margin:2rem 0;"></div>

    {%- comment -%} ── Bottom bar ── {%- endcomment -%}
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.copyright_extra != blank -%}
          {{ section.settings.copyright_extra }}
        {%- else -%}
          Tous droits réservés.
        {%- endif -%}
      </p>

      {%- comment -%} Payment icons — uses Shopify native enabled_payment_types {%- endcomment -%}
      <div class="footer-payments" aria-label="Moyens de paiement acceptés">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-svg' }}
        {%- else -%}
          <span class="payment-icon">VISA</span>
          <span class="payment-icon">MC</span>
          <span class="payment-icon">PAYPAL</span>
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

<style>
  .payment-svg {
    height: 22px;
    width: auto;
    opacity: 0.5;
    filter: grayscale(1) brightness(2);
    transition: opacity 0.2s;
  }
  .payment-svg:hover { opacity: 0.8; }
</style>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo du footer",
      "info": "Laissez vide pour afficher le nom de la boutique en texte."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largeur du logo",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Marque"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Description courte",
      "default": "Produits anti-moustiques pour profiter de l'extérieur — terrasse, jardin, voyage et camping."
    },
    {
      "type": "header",
      "content": "Réseaux sociaux"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube"
    },
    {
      "type": "header",
      "content": "Bas de page"
    },
    {
      "type": "text",
      "id": "copyright_extra",
      "label": "Texte après le copyright",
      "default": "Tous droits réservés."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Colonne de liens",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre de la colonne",
          "default": "Informations"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu à afficher",
          "info": "Créez des menus dans Boutique en ligne → Navigation. Vous pouvez créer un menu 'Informations légales', 'Service client', etc."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter (optionnel)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Newsletter"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Sous-titre",
          "default": "Offres exclusives et nouveautés directement dans votre boîte mail."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder du champ email",
          "default": "Votre adresse email"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texte du bouton",
          "default": "S'inscrire"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Informations légales",
            "menu": "footer-legal"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Service client",
            "menu": "footer-service"
          }
        }
      ]
    }
  ]
}
{% endschema %}
