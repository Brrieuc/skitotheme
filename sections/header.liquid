{%- if section.settings.show_announcement -%}
<div class="announcement-bar" role="banner">
  <span>{{ section.settings.announcement_text }}</span>
  <button class="announcement-close" aria-label="Fermer l'annonce" style="background:none;border:none;cursor:pointer;margin-left:1rem;color:inherit;font-size:1rem;">×</button>
</div>
{%- endif -%}

<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">

      {%- comment -%} Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="header-logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 120 }}"
               alt="{{ shop.name }}"
               width="120"
               height="40"
               loading="eager">
        {%- else -%}
          <div class="logo-icon" aria-hidden="true">⚡</div>
          {{ shop.name }}
        {%- endif -%}
      </a>

      {%- comment -%} Desktop Navigation {%- endcomment -%}
      <nav class="header-nav" role="navigation" aria-label="{{ 'accessibility.nav_label' | t }}">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links != blank -%}
            <div class="nav-dropdown" style="position:relative;">
              <a href="{{ link.url }}" class="{% if link.active %}active{% endif %}">{{ link.title }}</a>
            </div>
          {%- else -%}
            <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      {%- comment -%} Header Actions {%- endcomment -%}
      <div class="header-actions">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}"
             class="cart-icon-btn"
             aria-label="{{ 'customer.account.title' | t }}"
             title="{{ 'customer.account.title' | t }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
        {%- endif -%}

        <a href="{{ routes.cart_url }}"
           class="cart-icon-btn"
           aria-label="{{ 'sections.cart.title' | t }}"
           title="{{ 'sections.cart.title' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-count {% if cart.item_count > 0 %}has-items{% endif %}" aria-label="{{ cart.item_count }} articles">{{ cart.item_count }}</span>
        </a>

        <button class="mobile-menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

    </div>
  </div>

  {%- comment -%} Mobile Navigation {%- endcomment -%}
  <nav id="mobile-nav" class="mobile-nav" role="navigation" aria-label="Navigation mobile">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
    <div style="padding-top:1rem;border-top:1px solid var(--color-border);margin-top:0.5rem;">
      <a href="{{ routes.cart_url }}" class="btn btn-primary btn-full" style="text-align:center;">
        Panier ({{ cart.item_count }})
      </a>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navigation",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Afficher la barre d'annonce",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texte d'annonce",
      "default": "🚀 Livraison offerte dès 49€ — Protection anti-moustiques nouvelle génération"
    }
  ]
}
{% endschema %}
