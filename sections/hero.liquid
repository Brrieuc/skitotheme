<section class="hero" id="hero" aria-labelledby="hero-heading">

  <div class="hero-bg" aria-hidden="true">
    <div class="hero-gradient"></div>
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
  </div>

  <div class="container">
    <div class="hero-inner">

      {%- comment -%} Content {%- endcomment -%}
      <div class="hero-content">

        {%- if section.settings.badge_text != blank -%}
          <div class="hero-badge fade-in">
            <span class="badge badge-green">{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <h1 class="hero-title fade-in fade-in-delay-1" id="hero-heading">
          {%- if section.settings.headline_accent != blank -%}
            <span class="gradient-text">{{ section.settings.headline_accent }}</span>
            {%- if section.settings.headline_rest != blank -%}
              <br>{{ section.settings.headline_rest }}
            {%- endif -%}
          {%- else -%}
            {{ section.settings.headline }}
          {%- endif -%}
        </h1>

        {%- if section.settings.subtitle != blank -%}
          <p class="hero-subtitle fade-in fade-in-delay-2">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="hero-cta fade-in fade-in-delay-3">
          {%- if section.settings.cta_primary_text != blank -%}
            <a href="{{ section.settings.cta_primary_url }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_primary_text }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.cta_secondary_text != blank -%}
            <a href="{{ section.settings.cta_secondary_url }}" class="btn btn-secondary">
              {{ section.settings.cta_secondary_text }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Optional reassurance row — no fake stats {%- endcomment -%}
        <div class="hero-stats fade-in fade-in-delay-4">
          {%- if section.settings.badge_1 != blank -%}
            <div class="hero-stat">
              <span class="hero-stat-number" style="font-size:1rem;color:var(--color-text);">
                {{ section.settings.badge_1 }}
              </span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
          {%- endif -%}
          {%- if section.settings.badge_2 != blank -%}
            <div class="hero-stat">
              <span class="hero-stat-number" style="font-size:1rem;color:var(--color-text);">
                {{ section.settings.badge_2 }}
              </span>
            </div>
            <div class="hero-stat-divider" aria-hidden="true"></div>
          {%- endif -%}
          {%- if section.settings.badge_3 != blank -%}
            <div class="hero-stat">
              <span class="hero-stat-number" style="font-size:1rem;color:var(--color-text);">
                {{ section.settings.badge_3 }}
              </span>
            </div>
          {%- endif -%}
        </div>

      </div>

      {%- comment -%} Visual — product or image {%- endcomment -%}
      <div class="hero-visual fade-in fade-in-delay-2" aria-hidden="true">
        <div class="hero-product-card">
          <div class="hero-scan-line"></div>
          <div class="hero-card-badge">
            <span class="badge badge-green">{{ section.settings.card_badge | default: 'Nouveau' }}</span>
          </div>

          {%- if section.settings.product != blank -%}
            {%- assign hp = section.settings.product -%}
            {%- if hp.featured_image != blank -%}
              <img src="{{ hp.featured_image | image_url: width: 600 }}"
                   alt="{{ hp.featured_image.alt | escape | default: hp.title }}"
                   class="hero-product-image"
                   width="600"
                   loading="eager">
            {%- else -%}
              <div class="hero-product-image-placeholder">
                <span style="font-size:4rem;">🦟</span>
              </div>
            {%- endif -%}
            <div class="hero-product-info">
              <div class="hero-product-name">{{ hp.title }}</div>
              <div class="hero-product-tagline">{{ section.settings.card_tagline }}</div>
              <div class="hero-product-footer">
                <span class="hero-product-price">{{ hp.price | money }}</span>
                <a href="{{ hp.url }}" class="btn btn-primary btn-sm">Voir →</a>
              </div>
            </div>

          {%- elsif section.settings.hero_image != blank -%}
            <img src="{{ section.settings.hero_image | image_url: width: 600 }}"
                 alt="{{ section.settings.hero_image.alt | escape }}"
                 class="hero-product-image"
                 width="600"
                 loading="eager">
            <div class="hero-product-info">
              <div class="hero-product-name">{{ section.settings.card_title }}</div>
              <div class="hero-product-tagline">{{ section.settings.card_tagline }}</div>
              <div class="hero-product-footer">
                {%- if section.settings.card_price != blank -%}
                  <span class="hero-product-price">{{ section.settings.card_price }}</span>
                {%- endif -%}
                {%- if section.settings.cta_primary_text != blank -%}
                  <a href="{{ section.settings.cta_primary_url }}" class="btn btn-primary btn-sm">
                    Voir →
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- else -%}
            <div class="hero-product-image-placeholder">
              <span style="font-size:4rem;">⚡</span>
            </div>
            <div class="hero-product-info">
              <div class="hero-product-name">{{ section.settings.card_title }}</div>
              <div class="hero-product-tagline">{{ section.settings.card_tagline }}</div>
              <div class="hero-product-footer">
                {%- if section.settings.card_price != blank -%}
                  <span class="hero-product-price">{{ section.settings.card_price }}</span>
                {%- endif -%}
                {%- if section.settings.cta_primary_text != blank -%}
                  <a href="{{ section.settings.cta_primary_url }}" class="btn btn-primary btn-sm">
                    Voir →
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>

</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Texte principal"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge (optionnel)",
      "default": "⚡ Nouveau"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Titre — partie en dégradé",
      "default": "La protection anti-moustiques"
    },
    {
      "type": "text",
      "id": "headline_rest",
      "label": "Titre — suite normale",
      "default": "pour l'extérieur"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Profitez de vos soirées en terrasse, jardin, camping et voyages. Livraison rapide, retours faciles."
    },
    {
      "type": "header",
      "content": "Boutons"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Bouton principal",
      "default": "Voir nos produits"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Lien bouton principal"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Bouton secondaire (optionnel)"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Lien bouton secondaire"
    },
    {
      "type": "header",
      "content": "Bandeau de réassurance (optionnel)"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Élément 1",
      "default": "🚚 Livraison suivie"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Élément 2",
      "default": "↩️ Retours 30 jours"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Élément 3",
      "default": "🔒 Paiement sécurisé"
    },
    {
      "type": "header",
      "content": "Carte produit flottante"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produit à afficher",
      "info": "Sélectionnez un produit Shopify. Prioritaire sur l'image manuelle."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Image produit (si pas de produit sélectionné)"
    },
    {
      "type": "text",
      "id": "card_badge",
      "label": "Badge de la carte",
      "default": "Nouveau"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Nom produit (carte sans produit sélectionné)",
      "default": "Protection anti-moustiques"
    },
    {
      "type": "text",
      "id": "card_tagline",
      "label": "Tagline de la carte",
      "default": "Idéal terrasse, jardin & voyage"
    },
    {
      "type": "text",
      "id": "card_price",
      "label": "Prix affiché (carte sans produit sélectionné)",
      "default": "€29.90"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
