<section class="section" id="how-it-works" aria-labelledby="hiw-heading"
         style="background:var(--color-bg-2);">
  <div class="container">

    <div class="text-center fade-in">
      {%- if section.settings.label != blank -%}
        <p class="section-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2 class="section-title" id="hiw-heading">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="steps-grid">
      {%- for block in section.blocks -%}
        <div class="step-card glass-card fade-in fade-in-delay-{{ forloop.index }}"
             {{ block.shopify_attributes }}>
          <div class="step-number" aria-label="Étape {{ forloop.index }}">
            {{ forloop.index }}
          </div>
          <div class="step-icon" aria-hidden="true">{{ block.settings.icon }}</div>
          <h3 class="step-title">{{ block.settings.title }}</h3>
          <p class="step-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="text-center" style="margin-top:3rem;">
        <a href="{{ section.settings.cta_url }}" class="btn btn-primary btn-lg fade-in">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Comment ça marche",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Simple & rapide"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Commander, c'est facile"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "En quelques clics, votre commande est passée et expédiée vers chez vous."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Bouton CTA (optionnel)"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lien du CTA"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icône / Emoji",
          "default": "🛍️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l'étape",
          "default": "Choisissez votre produit"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Parcourez notre catalogue et ajoutez votre produit au panier."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comment ça marche",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "🛍️",
            "title": "Choisissez",
            "description": "Parcourez notre catalogue, sélectionnez votre produit et ajoutez-le au panier en un clic."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "💳",
            "title": "Commandez",
            "description": "Finalisez votre achat en toute sécurité. Paiement par carte, PayPal ou autre."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "📦",
            "title": "Recevez",
            "description": "Votre commande est préparée et expédiée avec un numéro de suivi envoyé par email."
          }
        }
      ]
    }
  ]
}
{% endschema %}
