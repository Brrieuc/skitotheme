<section class="section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">

    <div class="text-center fade-in reviews-header">
      {%- if section.settings.label != blank -%}
        <p class="section-label">{{ section.settings.label }}</p>
      {%- endif -%}
      <h2 class="section-title" id="reviews-heading">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      Barre de score — uniquement si les valeurs sont renseignées dans le customizer.
      Ne jamais afficher de stats inventées.
    {%- endcomment -%}
    {%- if section.settings.show_score_bar and section.settings.score != blank -%}
      <div class="reviews-summary fade-in">
        <div class="reviews-score">
          <div class="reviews-score-number">{{ section.settings.score }}</div>
          <div class="reviews-score-stars" aria-label="Note: {{ section.settings.score }}/5">★★★★★</div>
          {%- if section.settings.total_reviews != blank -%}
            <div class="reviews-score-count">{{ section.settings.total_reviews }} avis</div>
          {%- endif -%}
        </div>
        <div class="reviews-bars" role="img" aria-label="Répartition des notes">
          {%- assign bar_data = '5,4,3,2,1' | split: ',' -%}
          {%- for star in bar_data -%}
            {%- assign pct_key = 'pct_' | append: star -%}
            {%- assign pct_val = section.settings[pct_key] | default: 0 -%}
            <div class="review-bar-row">
              <span class="review-bar-label">{{ star }}★</span>
              <div class="review-bar-track">
                <div class="review-bar-fill" style="width:{{ pct_val }}%"></div>
              </div>
              <span class="review-bar-pct">{{ pct_val }}%</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Cards d'avis — uniquement les blocs ajoutés manuellement {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="reviews-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <article class="review-card glass-card fade-in fade-in-delay-{{ forloop.index }}"
                     {{ block.shopify_attributes }}>
              <div class="review-header">
                <div class="reviewer-info">
                  <div class="reviewer-avatar" aria-hidden="true">
                    {{ block.settings.name | slice: 0, 1 | upcase }}
                  </div>
                  <div>
                    <div class="reviewer-name">{{ block.settings.name }}</div>
                    <div class="reviewer-date">{{ block.settings.date }}</div>
                  </div>
                </div>
                {%- if block.settings.verified -%}
                  <span class="review-verified">✓ Achat vérifié</span>
                {%- endif -%}
              </div>

              <div class="review-stars"
                   aria-label="Note: {{ block.settings.rating }}/5">
                {%- assign r = block.settings.rating | plus: 0 -%}
                {%- for i in (1..5) -%}
                  {%- if i <= r -%}★{%- else -%}
                    <span style="opacity:0.25;">★</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="review-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              <p class="review-text">{{ block.settings.text }}</p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Avis clients"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Ce que disent nos clients"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sous-titre",
      "info": "Laissez vide pour ne pas afficher."
    },
    {
      "type": "header",
      "content": "Barre de score (optionnel)"
    },
    {
      "type": "checkbox",
      "id": "show_score_bar",
      "label": "Afficher la barre de score",
      "default": false,
      "info": "N'activez que si vous avez de vrais avis à afficher."
    },
    {
      "type": "text",
      "id": "score",
      "label": "Note moyenne (ex: 4.7)"
    },
    {
      "type": "text",
      "id": "total_reviews",
      "label": "Nombre total d'avis"
    },
    {
      "type": "range",
      "id": "pct_5",
      "label": "% 5 étoiles",
      "min": 0, "max": 100, "step": 1, "default": 70
    },
    {
      "type": "range",
      "id": "pct_4",
      "label": "% 4 étoiles",
      "min": 0, "max": 100, "step": 1, "default": 20
    },
    {
      "type": "range",
      "id": "pct_3",
      "label": "% 3 étoiles",
      "min": 0, "max": 100, "step": 1, "default": 7
    },
    {
      "type": "range",
      "id": "pct_2",
      "label": "% 2 étoiles",
      "min": 0, "max": 100, "step": 1, "default": 2
    },
    {
      "type": "range",
      "id": "pct_1",
      "label": "% 1 étoile",
      "min": 0, "max": 100, "step": 1, "default": 1
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis client",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Prénom et initiale",
          "default": "Sophie M."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Juin 2025"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1, "max": 5, "step": 1, "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Afficher badge 'Achat vérifié'",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre de l'avis (optionnel)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texte de l'avis",
          "default": "Très bon produit, livraison rapide et bien emballé. Je recommande !"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Avis clients"
    }
  ]
}
{% endschema %}
