<section class="section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">

    <div class="text-center fade-in reviews-header">
      <p class="section-label">{{ section.settings.label }}</p>
      <h2 class="section-title" id="reviews-heading">{{ section.settings.title }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    {%- comment -%} Summary bar {%- endcomment -%}
    <div class="reviews-summary fade-in">
      <div class="reviews-score">
        <div class="reviews-score-number">{{ section.settings.score }}</div>
        <div class="reviews-score-stars" aria-label="Note: {{ section.settings.score }}/5">★★★★★</div>
        <div class="reviews-score-count">{{ section.settings.total_reviews }} avis vérifiés</div>
      </div>
      <div class="reviews-bars" role="img" aria-label="Répartition des notes">
        <div class="review-bar-row">
          <span class="review-bar-label">5★</span>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:{{ section.settings.pct_5 }}%"></div></div>
          <span class="review-bar-pct">{{ section.settings.pct_5 }}%</span>
        </div>
        <div class="review-bar-row">
          <span class="review-bar-label">4★</span>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:{{ section.settings.pct_4 }}%"></div></div>
          <span class="review-bar-pct">{{ section.settings.pct_4 }}%</span>
        </div>
        <div class="review-bar-row">
          <span class="review-bar-label">3★</span>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:{{ section.settings.pct_3 }}%"></div></div>
          <span class="review-bar-pct">{{ section.settings.pct_3 }}%</span>
        </div>
        <div class="review-bar-row">
          <span class="review-bar-label">2★</span>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:{{ section.settings.pct_2 }}%"></div></div>
          <span class="review-bar-pct">{{ section.settings.pct_2 }}%</span>
        </div>
        <div class="review-bar-row">
          <span class="review-bar-label">1★</span>
          <div class="review-bar-track"><div class="review-bar-fill" style="width:{{ section.settings.pct_1 }}%"></div></div>
          <span class="review-bar-pct">{{ section.settings.pct_1 }}%</span>
        </div>
      </div>
    </div>

    {%- comment -%} Review cards {%- endcomment -%}
    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <article class="review-card glass-card fade-in fade-in-delay-{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="review-header">
              <div class="reviewer-info">
                <div class="reviewer-avatar" aria-hidden="true">{{ block.settings.name | slice: 0, 1 | upcase }}</div>
                <div>
                  <div class="reviewer-name">{{ block.settings.name }}</div>
                  <div class="reviewer-date">{{ block.settings.date }}</div>
                </div>
              </div>
              <span class="review-verified">✓ Achat vérifié</span>
            </div>
            <div class="review-stars" aria-label="Note: {{ block.settings.rating }}/5">
              {%- assign rating = block.settings.rating | plus: 0 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}★{%- else -%}<span style="opacity:0.3;">★</span>{%- endif -%}
              {%- endfor -%}
            </div>
            <h3 class="review-title">{{ block.settings.title }}</h3>
            <p class="review-text">{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
