{%- comment -%}
  Renders trust badges row.
  Usage: {% render 'trust-badges' %}
{%- endcomment -%}

<div class="trust-badges-row" role="list" aria-label="Garanties et informations de livraison">
  <div class="trust-badge" role="listitem">
    <span class="trust-badge-icon" aria-hidden="true">🚚</span>
    <span>Livraison offerte dès 49€</span>
  </div>
  <div class="trust-badge" role="listitem">
    <span class="trust-badge-icon" aria-hidden="true">↩️</span>
    <span>30j satisfait ou remboursé</span>
  </div>
  <div class="trust-badge" role="listitem">
    <span class="trust-badge-icon" aria-hidden="true">🔒</span>
    <span>Paiement sécurisé</span>
  </div>
  <div class="trust-badge" role="listitem">
    <span class="trust-badge-icon" aria-hidden="true">🏆</span>
    <span>2 ans de garantie</span>
  </div>
</div>
